# Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./burgersflow.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://burgers:flowpass@postgres:5432/burgersflow

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
ARTIFACTS_DIR=./artifacts_storage

# Quotas
DEFAULT_GPU_MIN_LIMIT=120
DEFAULT_MAX_ACTIVE_JOBS=2
